          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[$__rate_interval]))",
          "legendFormat": "Requests/s",
          "refId": "A"
